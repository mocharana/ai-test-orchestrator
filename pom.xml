<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方 parent：几千个常用依赖的版本搭配它已经测试好，
         我们声明依赖时不写版本号 = 由它统一发牌，避免版本打架 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <!-- 本项目的"身份证"：三维坐标定位唯一项目 -->
    <groupId>com.wen.aitest</groupId>
    <artifactId>ai-test-orchestrator</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ai-test-orchestrator</name>
    <description>AI 智能测试平台（阶段 5 简历主打项目）</description>

    <properties>
        <!-- 覆盖 parent 默认的 java.version=17，改用我们机器上的 OpenJDK 25 -->
        <java.version>25</java.version>
        <!-- jjwt 版本集中定义：三处依赖引用同一变量，升级只改这一个数（RuoYi 同款做法） -->
        <jjwt.version>0.13.0</jjwt.version>
    </properties>

    <!-- Spring AI 版本仲裁：BOM 统一发牌（作用同 parent 之于 Spring 官方全家桶），
         2.0.1 = 官方适配 Spring Boot 4 的版本线（10-14 技术栈定稿时已核实） -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>2.0.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web 套餐：Spring MVC（收发 HTTP）+ 内嵌 Tomcat 服务器 + JSON 序列化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验套餐：@NotBlank / @Email 等注解，M1 登录接口用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring AI（OpenAI starter）：AI 对话客户端。
             选 OpenAI starter 而非智谱专用 starter：智谱完全兼容 OpenAI 协议，
             base-url 指向智谱即可用智谱模型——一套客户端通吃所有兼容厂商，换模型只改配置 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- MyBatis-Plus：ORM 全家桶。
             注意！Spring Boot 4 必须用 boot4 专用坐标（SB3 用 boot3 结尾的），
             自动配置类不同，用错必报错——本项目的第一个版本坑 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- 分页插件模块：MP 3.5.9 起把 PaginationInnerInterceptor 拆出 extension
             （它依赖 jsqlparser，SQL 解析库版本升级频繁，官方解耦成可选模块）。
             不引它 = "找不到符号 PaginationInnerInterceptor"——本项目第二个第三方库拆分坑 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- MySQL 驱动：Java 与 MySQL 之间的"翻译官"。
             不写版本号（parent 管）；runtime = 只在程序运行时需要，写代码从不 import 它 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- BCrypt 密码加密：注意只引 Spring Security 的 crypto 单模块，
             不是整个 Security 安全框架（我们只要加密，不要登录页/过滤器全家桶）。
             版本不写——Spring 官方 BOM 管着它（对照 M1-3 的 jjwt：第三方要自己查） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JWT 三件套（官方推荐拆分式引法）：
             api    = 我们的代码要用的接口（编译期）
             impl   = 接口的实现（运行时才需要）
             jackson= JWT 与 JSON 互转的实现（运行时）
             jjwt 是纯工具库、不依赖 Spring——所以不存在"与 SB 4.1 适配"问题，
             只需 JDK 兼容（0.13 要 Java 8+，我们的 25 绰绰有余）。
             版本不写死三遍，引用 properties 里的 ${jjwt.version} -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Swagger：自动扫描接口并生成可交互文档网页（RuoYi 同款 3.0.2） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- Lombok：编译期自动生成 getter/setter，消灭模板代码。
             optional = 只在本项目生效，不传递给依赖我们的人 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试套餐：JUnit 5 + Mockito 等；test = 只参与测试，不进最终发布包 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 注解处理器显式声明：JDK 23 起 javac 默认关闭隐式注解处理（等效 -proc:none），
                 不声明则 CI 上 Lombok 完全不生效——所有 getter/log "cannot find symbol"。
                 IDEA 本地不炸是因为 IDEA 用自己的 Lombok 插件兜底——裸 Maven 必须自己声明。
                 proc=full + annotationProcessorPaths 双保险，让本地与 CI 行为一致 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 打"可执行 jar"的插件（java -jar 就能跑）；顺带把 lombok 排除出最终包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 阿里云镜像：下载依赖走国内 CDN，速度快（RuoYi 同款做法） -->
    <repositories>
        <repository>
            <id>aliyun</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-plugin</id>
            <name>aliyun nexus plugin</name>
            <url>https://maven.aliyun.com/repository/plugin</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
